<?xml version="1.0" encoding="utf-8"?>
<!-- On-screen keyboard key: white rounded square when focused, faint glass at rest (tvOS keyboard). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_focus" />
            <corners android:radius="8.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_glass_rest" />
            <corners android:radius="8.0dp" />
        </shape>
    </item>
</selector>
