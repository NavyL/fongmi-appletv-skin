<?xml version="1.0" encoding="utf-8"?>
<!-- Keyword fields in the danmaku/subtitle search sheets: same tvOS field, upstream's padding kept. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="10.0dp" />
            <stroke android:width="2.0dp" android:color="@color/tvos_focus" />
            <padding android:left="16.0dp" android:top="12.0dp" android:right="16.0dp" android:bottom="12.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvos_glass_rest" />
            <corners android:radius="10.0dp" />
            <stroke android:width="1.0dp" android:color="@color/tvos_hairline" />
            <padding android:left="16.0dp" android:top="12.0dp" android:right="16.0dp" android:bottom="12.0dp" />
        </shape>
    </item>
</selector>
