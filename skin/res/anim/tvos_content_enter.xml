<?xml version="1.0" encoding="utf-8"?>
<!-- A screen's content fades in and settles from slightly larger (tvOS), 220 ms ease-out. Played by the
     app itself (layoutAnimation), because Android 12+ TV builds skip app-defined window animations. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad" />
    <scale android:fromXScale="1.025" android:toXScale="1.0" android:fromYScale="1.025" android:toYScale="1.0" android:pivotX="50%" android:pivotY="50%" android:duration="220" android:interpolator="@android:interpolator/decelerate_cubic" />
</set>
