<?xml version="1.0" encoding="utf-8"?>
<!-- Content on a tvOS pill: black on the white focus plate, dark on the light "current" plate, white at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/tvos_on_focus" />
    <item android:state_selected="true" android:color="@color/tvos_on_selected" />
    <item android:color="@color/white" />
</selector>
