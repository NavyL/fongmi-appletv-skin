<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary text on a tvOS plate: dark grey on the white focus / light current plate, light grey at rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/tvos_disabled_text" />
    <item android:state_focused="true" android:color="#99000000" />
    <item android:state_selected="true" android:color="#99000000" />
    <item android:color="#A6FFFFFF" />
</selector>
