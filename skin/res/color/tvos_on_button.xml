<?xml version="1.0" encoding="utf-8"?>
<!-- Content on a tvOS button: black on the white focus plate, white otherwise (selected is ignored: marquee uses it). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/tvos_on_focus" />
    <item android:color="@color/white" />
</selector>
