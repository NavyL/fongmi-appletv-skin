<?xml version="1.0" encoding="utf-8"?>
<!-- Wallpaper (CustomWallView): image plus a readability scrim. Ids/classes as upstream. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    <View android:background="@drawable/tvos_wall_scrim" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
