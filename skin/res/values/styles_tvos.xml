<?xml version="1.0" encoding="utf-8"?>
<!-- Same-named styles replace upstream's; keep every upstream item and only add colours. -->
<resources>
    <style name="Theme.Base" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@color/tvos_canvas</item>
        <item name="android:colorBackground">@color/tvos_canvas</item>
        <!-- Type: Inter (SF Pro stand-in, as Aerial does), Medium by default like every tvOS text style; CJK falls back to the system font. -->
        <item name="android:fontFamily">@font/tvos_text</item>
        <item name="fontFamily">@font/tvos_text</item>
        <item name="android:textFontWeight">500</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/tvos_on_focus</item>
        <item name="colorPrimaryContainer">@color/tvos_selected</item>
        <item name="colorOnPrimaryContainer">@color/tvos_on_selected</item>
        <item name="colorSecondary">@color/tvos_selected</item>
        <item name="colorOnSecondary">@color/tvos_on_selected</item>
        <item name="colorSecondaryContainer">@color/tvos_raised</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiary">@color/tvos_amber</item>
        <item name="colorSurface">@color/tvos_panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/tvos_control</item>
        <item name="colorOnSurfaceVariant">@color/tvos_secondary</item>
        <item name="colorSurfaceDim">@color/tvos_canvas</item>
        <item name="colorSurfaceBright">@color/tvos_raised</item>
        <item name="colorSurfaceContainerLowest">@color/tvos_canvas</item>
        <item name="colorSurfaceContainerLow">@color/tvos_panel</item>
        <item name="colorSurfaceContainer">@color/tvos_panel</item>
        <item name="colorSurfaceContainerHigh">@color/tvos_panel</item>
        <item name="colorSurfaceContainerHighest">@color/tvos_control</item>
        <item name="colorOutline">@color/tvos_rim</item>
        <item name="colorOutlineVariant">@color/tvos_hairline</item>
        <item name="editTextStyle">@style/Widget.Tvos.EditText</item>
        <item name="android:editTextStyle">@style/Widget.Tvos.EditText</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Tvos.Alert</item>
        <item name="sideSheetDialogTheme">@style/ThemeOverlay.Tvos.SideSheet</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Tvos.BottomSheet</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>

    <!-- Poster corners: all four rounded (upstream rounds only the top, the name strip closed the bottom). -->
    <style name="Vod.Grid" parent="@style/Vod">
        <item name="cornerSize">6.0dp</item>
    </style>
    <style name="Vod.Grid.Large" parent="@style/Vod.Grid">
        <item name="cornerSize">6.0dp</item>
    </style>

    <!-- Player / live / cast control chips: tvOS pills (white focus, light "on" state for repeat etc.). -->
    <style name="Control">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/tvos_on_pill</item>
        <item name="android:background">@drawable/selector_tvos_pill</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">30.0dp</item>
        <item name="android:paddingStart">14.0dp</item>
        <item name="android:paddingEnd">14.0dp</item>
        <item name="android:paddingTop">6.0dp</item>
        <item name="android:paddingBottom">6.0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Glass dialogs/sheets: on Android 12+ the system blurs whatever is behind (Aerial's frosted
         panels, done by the compositor); the panel colour is translucent there (values-v31) and
         near-opaque on older TVs, where these attributes are ignored. -->
    <style name="ThemeOverlay.Tvos.Alert" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/tvos_blur_behind</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="colorSurfaceContainerHigh">@color/tvos_sheet</item>
        <item name="colorSurface">@color/tvos_sheet</item>
    </style>
    <style name="ThemeOverlay.Tvos.SideSheet" parent="@style/ThemeOverlay.Material3.SideSheetDialog">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/tvos_blur_behind</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="colorSurfaceContainerLow">@color/tvos_sheet</item>
        <item name="colorSurface">@color/tvos_sheet</item>
    </style>
    <style name="ThemeOverlay.Tvos.BottomSheet" parent="@style/ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/tvos_blur_behind</item>
        <item name="android:backgroundDimAmount">0.25</item>
        <item name="colorSurfaceContainerLow">@color/tvos_sheet</item>
        <item name="colorSurface">@color/tvos_sheet</item>
    </style>

    <!-- Upstream turns activity transitions off (Theme.Base windowAnimationStyle = NoAnim). Opening a
         screen is handled by the content fade (anim/tvos_screen_enter, works on every Android version);
         going back fades the closing screen out where the system honours app window animations (Android 11). -->
    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@anim/tvos_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/tvos_close_exit</item>
    </style>

    <!-- Text fields (CustomEditText extends TextInputEditText, default style attr = editTextStyle). -->
    <style name="Widget.Tvos.EditText" parent="@style/Widget.AppCompat.EditText">
        <item name="android:background">@drawable/selector_tvos_field</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/tvos_tertiary</item>
        <item name="android:textCursorDrawable">@drawable/shape_cursor</item>
        <item name="android:textSize">16.0sp</item>
    </style>
</resources>
