<?xml version="1.0" encoding="utf-8"?>
<!-- Same-named styles replace upstream's; keep every upstream item and only add colours. -->
<resources>
    <style name="Theme.Base" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@color/tvos_canvas</item>
        <item name="android:colorBackground">@color/tvos_canvas</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/tvos_on_focus</item>
        <item name="colorPrimaryContainer">@color/tvos_selected</item>
        <item name="colorOnPrimaryContainer">@color/tvos_on_selected</item>
        <item name="colorSecondary">@color/tvos_selected</item>
        <item name="colorOnSecondary">@color/tvos_on_selected</item>
        <item name="colorSecondaryContainer">@color/tvos_raised</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="colorTertiary">@color/tvos_amber</item>
        <item name="colorSurface">@color/tvos_panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/tvos_control</item>
        <item name="colorOnSurfaceVariant">@color/tvos_secondary</item>
        <item name="colorSurfaceDim">@color/tvos_canvas</item>
        <item name="colorSurfaceBright">@color/tvos_raised</item>
        <item name="colorSurfaceContainerLowest">@color/tvos_canvas</item>
        <item name="colorSurfaceContainerLow">@color/tvos_panel</item>
        <item name="colorSurfaceContainer">@color/tvos_panel</item>
        <item name="colorSurfaceContainerHigh">@color/tvos_panel</item>
        <item name="colorSurfaceContainerHighest">@color/tvos_control</item>
        <item name="colorOutline">@color/tvos_rim</item>
        <item name="colorOutlineVariant">@color/tvos_hairline</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>

    <!-- Poster corners: all four rounded (upstream rounds only the top, the name strip closed the bottom). -->
    <style name="Vod.Grid" parent="@style/Vod">
        <item name="cornerSize">6.0dp</item>
    </style>
    <style name="Vod.Grid.Large" parent="@style/Vod.Grid">
        <item name="cornerSize">6.0dp</item>
    </style>
</resources>
